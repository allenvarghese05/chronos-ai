  "info": {
    "description": "Behavioural wake detection + morning reel delivery.",
    "title": "Chronos-AI API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Return ``{\"ok\": true, \"version\": \"<version>\"}`` with HTTP 200.\n\nThis endpoint never checks external dependencies; a 200 means the process\nis running and imports are intact.",
        "operationId": "health_healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Healthz",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Return readiness of the service and its dependencies.\n\nHTTP 200 when all checks pass; HTTP 503 when any check fails.\nResponse body always contains ``{\"ok\": bool, \"db\": \"<status>\"}``.",
        "operationId": "health_readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/config/wake": {
      "get": {
        "description": "Return the currently active wake-engine rule version.\n\nRaises:\n    :class:`~chronos.errors.ProblemException` 500 if no active version\n        exists (startup guard should prevent this in prod).",
        "operationId": "config_get_config_wake",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigWakeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized \u2014 missing or invalid bearer token."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden \u2014 device token revoked."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity \u2014 validation failed."
          },
          "429": {
