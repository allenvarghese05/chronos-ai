# Chronos-AI environment variables.
# Copy this file to .env (gitignored) and fill in the values.
# Every variable is optional unless marked REQUIRED.

# ── environment ──────────────────────────────────────────────────────────────
# One of: dev | test | prod
CHRONOS_ENV=dev

# ── security (REQUIRED) ───────────────────────────────────────────────────────
# 32+ random bytes; generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CHRONOS_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY

# ── server ────────────────────────────────────────────────────────────────────
# LAN IP of this Mac (not 0.0.0.0). Find with: ipconfig getifaddr en0
CHRONOS_API_BIND_HOST=192.168.1.100
CHRONOS_API_BIND_PORT=8443

# ── TLS (required in prod) ────────────────────────────────────────────────────
# Paths to mkcert-generated certificate and key (chmod 600).
# Generate with: just certs   (T0.6)
CHRONOS_TLS_CERT=data/certs/chronos-local.pem
CHRONOS_TLS_KEY=data/certs/chronos-local-key.pem

# ── database ──────────────────────────────────────────────────────────────────
# SQLite file URL; the data/ directory is gitignored.
CHRONOS_DATABASE_URL=sqlite:///data/chronos.db

# ── logging ───────────────────────────────────────────────────────────────────
# Directory for structured JSON log files (created on startup if missing).
CHRONOS_LOG_DIR=data/logs

# ── LLM / Ollama ──────────────────────────────────────────────────────────────
# Ollama REST API base URL (default: local).
CHRONOS_OLLAMA_ENDPOINT=http://localhost:11434
# LLM provider: ollama | openai | anthropic  (openai/anthropic are opt-in fallbacks).
CHRONOS_LLM_PROVIDER=ollama

# ── Expo Push (optional) ──────────────────────────────────────────────────────
# Expo Access Token for the Enhanced Push service (leave blank for the free tier).
CHRONOS_EXPO_ACCESS_TOKEN=
